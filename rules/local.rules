# Transcribed verbatim from assets/step-05.png (/etc/snort/rules/local.rules).
# NOTE (review): ICMP itype:0 is Echo Reply and itype:8 is Echo Request, so the
# two msg labels below appear swapped. Left as-is to match the documented lab.
alert icmp any any -> $HOME_NET any (msg: "ICMP ECHO REQUEST DETECTED"; itype:0; sid:1000001; rev:1;)
alert icmp any any -> $HOME_NET any (msg: "ICMP ECHO REPLY DETECTED"; itype:8; sid:1000002; rev:1;)
alert tcp any any -> $HOME_NET any (msg: "TCP SYN STEALTH SCAN DETECTED"; flags:S,12; ack:0;dsize:0; sid:1000003; rev:1;)
